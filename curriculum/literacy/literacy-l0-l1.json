  "stages": [
    {
      "id": "L0",
      "title": "التهيئة قبل الحروف",
      "outcome": "الاستعداد للتعامل مع نظام الكتابة اللاتيني والتمييز البصري والسمعي الأولي.",
      "units": [
        {
          "id": "L0-U1",
          "title": "التعرف إلى نظام الكتابة",
          "lessons": [
            {
              "id": "L0-U1-L01",
              "title": "اللغة المنطوقة والكتابة والرمز",
              "objective": "يميز بين الصوت المكتوب والرمز والصورة.",
              "activity": "classify",
              "items": [
                {
                  "prompt": "أي خيار يمثل حرفًا مكتوبًا؟",
                  "choices": [
                    "A",
                    "🔊",
                    "🌳"
                  ],
                  "answer": "A"
                },
                {
                  "prompt": "أي خيار يمثل صورة لا حرفًا؟",
                  "choices": [
                    "m",
                    "☀️",
                    "s"
                  ],
                  "answer": "☀️"
                }
              ]
            },
            {
              "id": "L0-U1-L02",
              "title": "مطابقة الرموز",
              "objective": "يطابق الرمز بنسخة مطابقة له.",
              "activity": "match",
              "items": [
                {
                  "prompt": "اختر الرمز المطابق: b",
                  "choices": [
                    "d",
                    "b",
                    "p"
                  ],
                  "answer": "b"
                },
                {
                  "prompt": "اختر الرمز المطابق: M",
                  "choices": [
                    "W",
                    "N",
                    "M"
                  ],
                  "answer": "M"
                }
              ]
            },
            {
              "id": "L0-U1-L03",
              "title": "الحرف والكلمة والسطر",
              "objective": "يميز الحرف المفرد عن سلسلة الحروف.",
              "activity": "classify",
              "items": [
                {
                  "prompt": "أي خيار حرف واحد؟",
                  "choices": [
                    "cat",
                    "m",
                    "sun"
                  ],
                  "answer": "m"
                },
                {
                  "prompt": "أي خيار سلسلة حروف تكوّن كلمة مكتوبة؟",
                  "choices": [
                    "A",
                    "dog",
                    "/"
                  ],
                  "answer": "dog"
                }
              ]
            },
            {
              "id": "L0-U1-L04",
              "title": "اتجاه الكتابة اللاتينية",
              "objective": "يتعرف أن السطر الإنجليزي يبدأ من اليسار إلى اليمين.",
              "activity": "sequence",
              "items": [
                {
                  "prompt": "في أي اتجاه نقرأ هذا السطر؟",
                  "choices": [
                    "من اليسار إلى اليمين",
                    "من اليمين إلى اليسار"
                  ],
                  "answer": "من اليسار إلى اليمين"
                }
              ]
            }
          ]
        },
